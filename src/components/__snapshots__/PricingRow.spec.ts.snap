exports[`PricingRow > matches HTML snapshot for a dirty row with no cost data 1`] = `
"<div data-v-28c293e9="" class="pricing-row" data-recipe-id="test-recipe" data-dirty="true">
  <!-- Row 1: name + dirty badge + cost -->
  <div data-v-28c293e9="" class="pricing-row-top">
    <div data-v-28c293e9="" class="pricing-row-name-wrap"><span data-v-28c293e9="" class="pricing-row-name">Test Recipe</span><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-center help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-dirty">modified</span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Differs from committed default. Export to save.</span></span><span data-v-28c293e9="" class="pricing-row-id">test-recipe</span></div>
    <div data-v-28c293e9="" class="pricing-row-cost"><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-right help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-cost-missing">no cost data</span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">No cost recorded yet — add a cook_log entry with cost.items.</span></span><span data-v-28c293e9="" class="pricing-row-label">cost</span></div>
  </div><!-- Row 2: slider + readout -->
  <div data-v-28c293e9="" class="pricing-row-controls">
    <div data-v-28c293e9="" class="pricing-row-slider-wrap"><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-left help-tooltip--placement-top pricing-row-slider-tooltip"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><input data-v-28c293e9="" type="range" class="pricing-row-slider" min="50" max="300" step="1" aria-label="Markup percent for Test Recipe" value="200"></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Markup percent — drag to set retail price (50% to 300%).</span></span>
      <div data-v-28c293e9="" class="pricing-row-slider-readout"><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-left help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-markup">200%</span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Markup as a percentage above variable cost.</span></span><span data-v-28c293e9="" class="pricing-row-label">markup</span></div>
    </div>
    <div data-v-28c293e9="" class="pricing-row-readout">
      <div data-v-28c293e9="" class="pricing-row-price pricing-row-price--missing">—</div>
      <!--v-if-->
    </div>
  </div><!-- Row 3: nudge hint -->
  <!--v-if-->
</div>"
`;

exports[`PricingRow > matches HTML snapshot for a typical row 1`] = `
"<div data-v-28c293e9="" class="pricing-row" data-recipe-id="test-recipe" data-dirty="false">
  <!-- Row 1: name + dirty badge + cost -->
  <div data-v-28c293e9="" class="pricing-row-top">
    <div data-v-28c293e9="" class="pricing-row-name-wrap"><span data-v-28c293e9="" class="pricing-row-name">Test Recipe</span>
      <!--v-if--><span data-v-28c293e9="" class="pricing-row-id">test-recipe</span>
    </div>
    <div data-v-28c293e9="" class="pricing-row-cost"><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-right help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-cost-value">$2.50</span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Variable cost per recipe — most recent cook_log[].cost.total.</span></span><span data-v-28c293e9="" class="pricing-row-label">cost</span></div>
  </div><!-- Row 2: slider + readout -->
  <div data-v-28c293e9="" class="pricing-row-controls">
    <div data-v-28c293e9="" class="pricing-row-slider-wrap"><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-left help-tooltip--placement-top pricing-row-slider-tooltip"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><input data-v-28c293e9="" type="range" class="pricing-row-slider" min="50" max="300" step="1" aria-label="Markup percent for Test Recipe" value="150"></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Markup percent — drag to set retail price (50% to 300%).</span></span>
      <div data-v-28c293e9="" class="pricing-row-slider-readout"><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-left help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-markup">150%</span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Markup as a percentage above variable cost.</span></span><span data-v-28c293e9="" class="pricing-row-label">markup</span></div>
    </div>
    <div data-v-28c293e9="" class="pricing-row-readout">
      <div data-v-28c293e9="" class="pricing-row-price"><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-right help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-pretty">$6.50</span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Snapped retail price — pretty-pricing rounded from raw $6.25.</span></span><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-right help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-raw">raw $6.25</span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Raw price — variable cost × (1 + markup%), before pretty-price snap.</span></span></div>
      <div data-v-28c293e9="" class="pricing-row-cp"><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-right help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-cp-dollar">$4.00</span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Contribution profit in dollars — retail price minus variable cost.</span></span><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-right help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-cp-pct">61.5% CP</span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Contribution profit as a share of retail price.</span></span></div>
    </div>
  </div><!-- Row 3: nudge hint -->
  <div data-v-28c293e9="" class="pricing-row-hint-wrap"><span data-v-65c8741e="" data-v-28c293e9="" class="help-tooltip help-tooltip--align-left help-tooltip--placement-top"><span data-v-65c8741e="" class="help-tooltip-trigger" aria-describedby="help-tooltip-1"><span data-v-28c293e9="" class="pricing-row-hint"> Nudge up to <strong data-v-28c293e9="">$6.95</strong> for <strong data-v-28c293e9="">+$0.45</strong> CP </span></span><span data-v-65c8741e="" id="help-tooltip-1" role="tooltip" class="help-tooltip-popover" data-open="false">Bumping to the next pretty price increases contribution profit by this much.</span></span></div>
</div>"
`;
