  "states": [
    {
      "id": "beat-cream-cheese",
      "title": "Beat Cream Cheese",
      "direction": "In stand mixer bowl fitted with paddle attachment, beat the softened cream cheese on medium speed for 5 minutes to soften and aerate slightly.",
      "duration_min": 5,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "cream cheese",
          "amount": "225g"
        }
      ],
      "exit_condition": "Cream cheese is smooth, lightened in color, and slightly aerated — no visible lumps or hard chunks.",
      "notes": [
        {
          "text": "Cream cheese must be at true room temperature (~68°F/20°C). Cold cream cheese will not aerate; the dough will be lumpy.",
          "critical": false,
          "source": "agent"
        }
      ],
      "reminders": null
    },
    {
      "id": "add-butter",
      "title": "Add Softened Butter",
      "direction": "Add the softened butter and mix on medium speed until smooth, 1 to 2 minutes, stopping the mixer to scrape down the sides of the bowl a few times.",
      "duration_min": 2,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "unsalted butter",
          "amount": "225g"
        }
      ],
      "exit_condition": "Cream cheese and butter are fully combined into a smooth, homogeneous mixture with no streaks of butter visible.",
      "notes": null,
      "reminders": null
    },
    {
      "id": "add-flours-salt",
      "title": "Add Flours and Salt",
      "direction": "Add both flours and the salt. Mix on medium speed until the dough just comes together and begins to ball around the paddle. Do not overmix.",
      "duration_min": 2,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "all-purpose flour",
          "amount": "260g"
        },
        {
          "name": "einkorn flour",
          "amount": "65g"
        },
        {
          "name": "fine sea salt",
          "amount": "6g"
        }
      ],
      "exit_condition": "Dough balls around the paddle but is moist with some chunks and visible specks of loose flour. Not totally cohesive — that's correct.",
      "notes": [
        {
          "text": "Undermixing is the goal. Overmixed dough develops gluten and loses flakiness. Specks of loose flour should still be visible.",
          "critical": true,
          "source": "agent"
        }
      ],
      "reminders": null
    },
    {
      "id": "shape-disc",
      "title": "Shape Dough Disc",
      "direction": "Turn the dough out onto a sheet of plastic wrap and form a 2.5cm thick disc. Wrap tightly.",
      "duration_min": 2,
      "timer": false,
      "parallel": false,
      "components": null,
      "exit_condition": "Dough is a flat disc roughly 2.5cm thick, tightly wrapped in plastic with no exposed dough.",
      "notes": null,
      "reminders": null
    },
    {
      "id": "chill-dough",
      "title": "Chill Dough",
      "direction": "Refrigerate the wrapped dough for at least 1 hour, or overnight.",
      "duration_min": 60,
      "timer": true,
      "parallel": false,
      "components": null,
      "exit_condition": "Dough is firm and cold throughout, no longer tacky. Easy to roll without sticking excessively.",
      "notes": [
        {
          "text": "Overnight chill is fine and often improves both flavor and roll-out behavior — dough relaxes and rolls more evenly.",
          "critical": false,
          "source": "agent"
        }
      ],
      "reminders": [
        {
          "prompt": "Dough texture out of fridge — too firm, just right, or still soft?",
          "type": "observation"
        }
      ]
    },
    {
      "id": "pulse-walnuts",
      "title": "Pulse Walnuts",
      "direction": "In food processor fitted with the steel blade, pulse the walnuts until the pieces are small — about the size of sunflower seeds.",
      "duration_min": 1,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "walnuts",
          "amount": "120g"
        }
      ],
      "exit_condition": "Walnut pieces are roughly sunflower-seed sized — uniform pieces, not powdered, no whole halves remaining.",
      "notes": [
        {
          "text": "Over-processing turns walnuts into nut butter. Stop when most pieces are small but a few are still slightly larger.",
          "critical": false,
          "source": "agent"
        }
      ],
      "reminders": null
    },
    {
      "id": "add-sugar-cinnamon",
      "title": "Add Brown Sugar and Cinnamon",
      "direction": "Add the brown sugar and ground cinnamon to the processor. Pulse again to combine.",
      "duration_min": 1,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "brown sugar",
          "amount": "120g"
        },
        {
          "name": "ground cinnamon",
          "amount": "7g"
        }
      ],
      "exit_condition": "Sugar, cinnamon, and walnut pieces are evenly mixed — uniform light brown color throughout, no streaks of plain sugar.",
      "notes": null,
      "reminders": null
    },
    {
      "id": "stir-currants",
      "title": "Stir in Currants",
      "direction": "Transfer the walnut-sugar mixture to a medium bowl. Stir in the currants by hand — do not pulse.",
      "duration_min": 1,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "currants",
          "amount": "70g"
        }
      ],
      "exit_condition": "Currants are evenly distributed throughout the filling but remain whole. Filling is ready to spread.",
      "notes": null,
      "reminders": null
    },
    {
      "id": "preheat-oven",
      "title": "Preheat Oven",
      "direction": "Adjust oven rack to middle position. Preheat oven to 350°F (180°C). Line the baking sheet with parchment paper or a nonstick liner.",
      "duration_min": 15,
      "timer": true,
      "parallel": true,
      "components": null,
      "exit_condition": "Oven is fully preheated to 350°F (180°C) and the baking sheet is lined and ready.",
      "notes": null,
      "reminders": null
    },
    {
      "id": "roll-circle",
      "title": "Roll Dough to 28cm Circle",
      "direction": "Lightly dust your work surface with flour and turn the chilled dough out onto it. Using a rolling pin, roll out the dough to form a circle 28cm in diameter and a little thicker than 3mm.",
      "duration_min": 5,
      "timer": false,
      "parallel": false,
      "components": null,
      "exit_condition": "Dough is a 28cm round, evenly thick at slightly over 3mm. Edges may be ragged — that's fine.",
      "notes": [
        {
          "text": "If the dough cracks or feels too firm to roll, let it rest at room temperature 5-10 minutes before rolling.",
          "critical": false,
          "source": "agent"
        }
      ],
      "reminders": null
    },
    {
      "id": "brush-butter",
      "title": "Brush with Melted Butter",
      "direction": "Very lightly brush the rolled dough surface with the melted, cooled butter.",
      "duration_min": 1,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "melted butter",
          "amount": "65g"
        }
      ],
      "exit_condition": "Entire dough surface has a thin, even layer of melted butter — not pooling or saturated.",
      "notes": null,
      "reminders": null
    },
    {
      "id": "spread-filling",
      "title": "Spread Walnut-Currant Filling",
      "direction": "Spread a thick layer of the walnut-currant filling over the buttered dough, equal in thickness to the dough. Leave a 12mm border around the edge.",
      "duration_min": 2,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "walnut-currant filling",
          "amount": "~315g (all)"
        }
      ],
      "exit_condition": "Filling covers the dough in an even layer roughly 3mm thick, with a clean 12mm border at the edge.",
      "notes": null,
      "reminders": null
    },
    {
      "id": "cut-sixteen",
      "title": "Cut into 16 Triangles",
      "direction": "With a pizza cutter or sharp knife, cut the dough round in half, then each half into quarters, and so on until you have 16 equal triangular pieces.",
      "duration_min": 3,
      "timer": false,
      "parallel": false,
      "components": null,
      "exit_condition": "16 evenly sized triangular wedges, each with a wide base at the outer edge of the circle and a narrow point at the center.",
      "notes": null,
      "reminders": null
    },
    {
      "id": "roll-triangles",
      "title": "Roll Triangles into Crescents",
      "direction": "Starting at the base of a triangle, lightly roll up the dough so that the tip of the triangle tucks under the base of the cookie. Lightly push down to secure the shape. Place each rolled rugelach onto the parchment-lined baking sheet.",
      "duration_min": 8,
      "timer": false,
      "parallel": false,
      "components": null,
      "exit_condition": "16 rolled crescents arranged on the baking sheet with the tucked tip on the bottom. Spacing roughly 5cm apart so they don't merge during bake.",
      "notes": [
        {
          "text": "Roll snug but not tight — over-tight rolls can split during baking. Tip tucked under the base prevents unrolling.",
          "critical": false,
          "source": "agent"
        }
      ],
      "reminders": null
    },
    {
      "id": "freeze-shaped",
      "title": "Freeze Shaped Rugelach",
      "direction": "Transfer the baking sheet to the freezer for 10-15 minutes to firm up the shapes before baking.",
      "duration_min": 12,
      "timer": true,
      "parallel": false,
      "components": null,
      "exit_condition": "Rugelach are firm to the touch and hold their shape — well chilled but not frozen solid.",
      "notes": [
        {
          "text": "The freeze step keeps the butter cold so the dough holds shape during the egg wash and the initial oven hit — critical for flake structure.",
          "critical": false,
          "source": "agent"
        }
      ],
      "reminders": null
    },
    {
      "id": "egg-wash-sugar",
      "title": "Egg Wash and Sugar",
      "direction": "Whisk the egg in a small bowl. Remove the baking sheet from the freezer. Brush each cookie with the egg wash, then sprinkle generously with granulated sugar.",
      "duration_min": 3,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "egg",
          "amount": "1 large (~50g)"
        },
        {
          "name": "sugar for topping",
          "amount": "~20g"
        }
      ],
      "exit_condition": "Each cookie has a thin, even egg wash coating and a visible sugar dusting on top.",
      "notes": null,
      "reminders": null
    },
    {
      "id": "bake",
      "title": "Bake",
      "direction": "Bake at 350°F (180°C) until golden brown and the base of each cookie is set and slightly darker than the tops, 20-25 minutes.",
      "duration_min": 22,
      "timer": true,
      "parallel": false,
      "components": null,
      "exit_condition": "Tops are golden brown. Bottoms are set and slightly darker than the tops. Filling visible at the cut ends is bubbling slightly.",
      "notes": [
        {
          "text": "Rotate sheet halfway through if your oven has hot spots — the front of the sheet often browns faster than the back.",
          "critical": false,
          "source": "agent"
        }
      ],
      "reminders": [
        {
          "prompt": "How were the bottoms — pale, golden, or scorched?",
          "type": "observation"
