      "direction": "Pour 794g Sclafani crushed tomatoes into the bowl. Rinse the can with 57g water and add to the bowl. Hand blend until broken down — some texture is good, don't fully puree.",
      "duration_min": 3,
      "timer": false,
      "parallel": false,
      "components": [
        {
          "name": "Sclafani Crushed Tomatoes",
          "amount": "794g (one 28oz can)"
