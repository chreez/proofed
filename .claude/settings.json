{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(open http://localhost:*)",
      "Read",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/remind-validate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
